# Create a Web application client in Google Cloud Console and paste its client ID here.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Server-only OAuth client secret used to exchange authorization codes and refresh Gmail access.
# Never prefix this variable with NEXT_PUBLIC_ and never commit the real value.
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret

# Generate a long, random value (at least 32 characters) for signing the session cookie.
AUTH_SECRET=replace-with-a-long-random-secret

# Shared OpenRouter key. Keep this server-side; never prefix it with NEXT_PUBLIC_.
OPENROUTER_API_KEY=
OPENROUTER_PROFILE_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_GOALS_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_DRAFT_MODEL=google/gemini-2.5-flash-lite
